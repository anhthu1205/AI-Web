# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Session Pooler của Supabase, role app_readonly (mật khẩu do bạn tự đặt):
# postgresql://app_readonly.kxebriimlhwenbzfkekd:<MAT_KHAU>@<pooler-host>:5432/postgres
DATABASE_URL=
REFERENCE_DATE=2026-11-08
ALLOWED_ORIGINS=http://localhost:8000
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=5000
RATE_LIMIT=10/minute
# Chế độ demo (LLM + DB giả) CHỈ để thử giao diện. Không bật ở production.
DEMO_MODE=false
